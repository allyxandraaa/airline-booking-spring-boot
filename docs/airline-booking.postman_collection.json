{
  "info": {
    "_postman_id": "51d63c3b-7a20-48d7-bec4-89e92ea67da9",
    "name": "Airline Booking",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Логін: отримати токен у Keycloak",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "airline-client"
            },
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "username",
              "value": "{{username}}"
            },
            {
              "key": "password",
              "value": "{{password}}"
            }
          ]
        },
        "url": {
          "raw": "{{keycloakUrl}}/realms/airline/protocol/openid-connect/token",
          "host": [
            "{{keycloakUrl}}"
          ],
          "path": [
            "realms",
            "airline",
            "protocol",
            "openid-connect",
            "token"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('логін успішний', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('accessToken', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Без токена: очікуємо 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/flights/11111111-1111-1111-1111-111111111111/price?ticketClass=ECONOMY",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "flights",
            "11111111-1111-1111-1111-111111111111",
            "price"
          ],
          "query": [
            {
              "key": "ticketClass",
              "value": "ECONOMY"
            }
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 без токена', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Створити рейс (мала місткість і овербукінг)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/flights",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "flights"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"flightNumber\": \"PS101\",\n  \"origin\": \"KBP\",\n  \"destination\": \"WAW\",\n  \"departureTime\": \"{{departure}}\",\n  \"totalSeatsEconomy\": 1,\n  \"totalSeatsBusiness\": 1,\n  \"basePriceEconomy\": 120.0,\n  \"basePriceBusiness\": 250.0,\n  \"overbookingLimitPercent\": 100\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('departure', new Date(Date.now() + 10 * 86400000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('flightId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Створити пасажира",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/passengers",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "passengers"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Ivan Petrenko\",\n  \"email\": \"ivan@example.com\",\n  \"phone\": \"+380501234567\",\n  \"documentNumber\": \"AB123456\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('passengerId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Ціна квитка",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/flights/{{flightId}}/price?ticketClass=ECONOMY",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "flights",
            "{{flightId}}",
            "price"
          ],
          "query": [
            {
              "key": "ticketClass",
              "value": "ECONOMY"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Бронювання 1 (SAGA: місце, оплата через Kafka)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/bookings",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "bookings"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"flightId\": \"{{flightId}}\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"passengerName\": \"Ivan Petrenko\",\n  \"ticketClass\": \"ECONOMY\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('bookingId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Бронювання 2 (понад місткість, овербукінг)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/bookings",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "bookings"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"flightId\": \"{{flightId}}\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"passengerName\": \"Ivan Petrenko\",\n  \"ticketClass\": \"ECONOMY\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Статус бронювання (дочекатись CONFIRMED)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/bookings/{{bookingId}}",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "bookings",
            "{{bookingId}}"
          ],
          "query": []
        }
      },
      "event": []
    },
    {
      "name": "9. Платежі бронювання",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/payments?bookingId={{bookingId}}",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "payments"
          ],
          "query": [
            {
              "key": "bookingId",
              "value": "{{bookingId}}"
            }
          ]
        }
      },
      "event": []
    },
    {
      "name": "10. Розв'язати овербукінг рейсу",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/overbooking/flights/{{flightId}}/resolution",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "overbooking",
            "flights",
            "{{flightId}}",
            "resolution"
          ],
          "query": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('reportId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Звіт про овербукінг",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/overbooking/reports/{{reportId}}",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "overbooking",
            "reports",
            "{{reportId}}"
          ],
          "query": []
        }
      },
      "event": []
    },
    {
      "name": "12. Компенсація за списком бронювань",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/overbooking/compensations",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "overbooking",
            "compensations"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingIds\": [\n    \"{{bookingId}}\"\n  ]\n}"
        }
      },
      "event": []
    },
    {
      "name": "13. Помилка валідації: очікуємо 400 ProblemDetail",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/api/v1/bookings",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "bookings"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"flightId\": null\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}